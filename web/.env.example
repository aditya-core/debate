# Gift of Words — environment
# Copy to web/.env.local and fill in. Never commit the filled file.

# Supabase → Project Settings → Data API (URL) and API Keys
#
# The key is either the legacy `anon` JWT (starts `eyJ...`) or the newer
# publishable key (starts `sb_publishable_...`). Both work and both are public.
# NEVER paste the `sb_secret_...` / service_role key here — it ignores RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# There is deliberately no service-role key here. Privileged work happens
# inside Postgres (RLS + SECURITY DEFINER functions), never in the app.
# See docs/SUPABASE-SETUP.md


#
# Currently PAUSED: sign-up returns a session immediately and goes straight to
# the setup wizard. Set to `true` AND enable "Confirm email" in Supabase
# (Authentication → Sign In / Providers → Email, with a working SMTP sender) to
# require the mail hop again. Both switches, or neither.
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# No mail provider is configured. Email verification and the six-digit code
# were removed in D-087; sign-up goes straight to setup.
