# Gift of Words — environment
# Copy to web/.env.local and fill in. Never commit the filled file.

# Supabase → Project Settings → Data API (URL) and API Keys (anon/public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# There is deliberately no service-role key here. Privileged work happens
# inside Postgres (RLS + SECURITY DEFINER functions), never in the app.
# See docs/SUPABASE-SETUP.md
